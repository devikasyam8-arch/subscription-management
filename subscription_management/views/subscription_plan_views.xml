<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_plan_list" model="ir.ui.view">
        <field name="name">subscription.plan.list</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="billing_period_count"/>
                <field name="billing_period"/>
                <field name="subscription_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_view_subscriptions" type="object"
                            string="Subscriptions" class="oe_highlight"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="subscription_count" widget="statinfo"
                                   string="Subscriptions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Premium Monthly"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="price"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <label for="billing_period_count"/>
                            <div class="o_row">
                                <field name="billing_period_count"/>
                                <field name="billing_period"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Plan details..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subscription_plans" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
